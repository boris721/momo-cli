#!/usr/bin/env node

import { readFileSync } from 'fs';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';
import * as cmd from '../lib/commands.js';
import { extractProfile } from '../lib/commands.js';

const __dirname = dirname(fileURLToPath(import.meta.url));
const pkg = JSON.parse(readFileSync(join(__dirname, '..', 'package.json'), 'utf8'));
const VERSION = pkg.version;

const rawArgs = process.argv.slice(2);
const command = rawArgs[0];
const subcommand = rawArgs[1];

function withProfile(args) {
  const { profileName, remainingArgs } = extractProfile(args);
  return { profileName, args: remainingArgs };
}

async function main() {
  try {
    switch (command) {
      case 'auth':
        if (subcommand === 'status') {
          await cmd.authStatus();
        } else if (subcommand === 'list') {
          await cmd.authList();
        } else if (subcommand === 'default') {
          await cmd.authSetDefault(rawArgs[2]);
        } else if (subcommand === 'delete') {
          await cmd.authDelete(rawArgs[2]);
        } else if (rawArgs[1] && rawArgs[2]) {
          if (rawArgs[3]) {
            await cmd.authSave(rawArgs[1], rawArgs[2], rawArgs[3]);
          } else {
            await cmd.authSave(rawArgs[1], rawArgs[2]);
          }
        } else {
          console.error('Usage: momo auth <secret> <clientid>');
          console.error('       momo auth <profile-name> <secret> <clientid>');
          console.error('       momo auth status');
          console.error('       momo auth default <name>');
          process.exit(1);
        }
        break;

      case 'sw': {
        const swArgs = withProfile(rawArgs.slice(1));
        if (!swArgs.args[0]) {
          await cmd.stopwatchStatus(swArgs.profileName);
        } else if (swArgs.args[0] === 'start') {
          await cmd.stopwatchStart(swArgs.profileName);
        } else if (swArgs.args[0] === 'pause') {
          await cmd.stopwatchPause(swArgs.profileName);
        } else if (swArgs.args[0] === 'stop') {
          await cmd.stopwatchStop(swArgs.profileName);
        } else {
          console.error('Usage: momo sw [--profile NAME] [start|pause|stop]');
          process.exit(1);
        }
        break;
      }

      case 'log': {
        const logArgs = withProfile(rawArgs.slice(1));
        await cmd.logTime(logArgs.args, logArgs.profileName);
        break;
      }

      case 'status': {
        const statusArgs = withProfile(rawArgs.slice(1));
        await cmd.showStatus(statusArgs.args, statusArgs.profileName);
        break;
      }

      case 'timelog': {
        const tlArgs = withProfile(rawArgs.slice(1));
        if (tlArgs.args[0] === 'delete') {
          const id = tlArgs.args[1];
          const force = tlArgs.args.includes('--force');
          await cmd.deleteTimelog(id, { force }, tlArgs.profileName);
        } else {
          console.error('Usage: momo timelog delete <id> [--force] [--profile NAME]');
          process.exit(1);
        }
        break;
      }

      case 'colors': {
        const cArgs = withProfile(rawArgs.slice(1));
        await cmd.listColors(cArgs.profileName);
        break;
      }

      case 'project': {
        const pArgs = withProfile(rawArgs.slice(1));

        const parseProjectOptions = (startIndex) => {
          const options = {};
          const projectArgs = pArgs.args.slice(startIndex);
          let name = null;

          for (let i = 0; i < projectArgs.length; i++) {
            if (projectArgs[i] === '--color' && projectArgs[i + 1]) {
              options.color = projectArgs[i + 1];
              i++;
            } else if (projectArgs[i] === '--description' && projectArgs[i + 1]) {
              options.description = projectArgs[i + 1];
              i++;
            } else if (projectArgs[i] === '--force') {
              options.force = true;
            } else if (!projectArgs[i].startsWith('--')) {
              name = projectArgs[i];
            }
          }

          return { name, options };
        };

        if (pArgs.args[0] === 'list' || !pArgs.args[0]) {
          await cmd.listProjects(pArgs.profileName);
        } else if (pArgs.args[0] === 'colors') {
          await cmd.listColors(pArgs.profileName);
        } else if (pArgs.args[0] === 'add') {
          const { name, options } = parseProjectOptions(1);
          await cmd.addProject(name, options, pArgs.profileName);
        } else if (pArgs.args[0] === 'update') {
          const { name, options } = parseProjectOptions(1);
          await cmd.updateProject(name, options, pArgs.profileName);
        } else if (pArgs.args[0] === 'delete') {
          const { name, options } = parseProjectOptions(1);
          await cmd.deleteProject(name, options, pArgs.profileName);
        } else {
          console.error('Usage: momo project [--profile NAME] list');
          console.error('       momo project [--profile NAME] add <name>');
          process.exit(1);
        }
        break;
      }

      case 'version':
      case '--version':
      case '-v':
        console.log(`momo-cli v${VERSION}`);
        break;

      case 'help':
      case '--help':
      case '-h':
        cmd.showHelp();
        break;

      case undefined:
        cmd.showHelp();
        break;

      default:
        console.error(`Unknown command: ${command}`);
        console.error('Run: momo help');
        process.exit(1);
    }
  } catch (err) {
    if (err.name === 'ApiError') {
      console.error(`✗ ${err.message}`);
    } else {
      console.error(`✗ Error: ${err.message}`);
    }
    process.exit(1);
  }
}

main();
